# copy to .env or export in shell. No SDKs needed (plain HTTP).
LLM_PROVIDER=gemini          # gemini | anthropic | openai (any OpenAI-compatible) | none
LLM_MODEL=                   # put a current model name from your provider's docs
LLM_API_KEY=
# LLM_BASE_URL=              # only for OpenAI-compatible endpoints
